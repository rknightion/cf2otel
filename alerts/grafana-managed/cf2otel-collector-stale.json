{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "cf2otel-collector-stale"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "cf2otel",
      "__panelId__": "401",
      "description": "Collector last-success timestamp is older than 15 minutes.",
      "runbook_url": "https://github.com/rknightion/cf2otel/blob/main/docs/troubleshooting.md",
      "summary": "cf2otel collector is stale"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "time() - (max by (cf2otel_collector) (cf2otel_scrape_last_success_timestamp_seconds{service_name=\"cf2otel\"}) or max by (cf2otel_collector) (cf2otel_scrape_last_success_timestamp{service_name=\"cf2otel\"}))",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  900
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m",
    "labels": {
      "category": "collector",
      "pipeline": "cf2otel",
      "service": "cf2otel",
      "severity": "warning",
      "source": "cf2otel"
    },
    "noDataState": "Alerting",
    "panelRef": {
      "dashboardUID": "cf2otel",
      "panelID": 401
    },
    "paused": false,
    "title": "cf2otel collector is stale",
    "trigger": {
      "interval": "1m"
    }
  }
}
