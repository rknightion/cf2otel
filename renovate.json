{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tool version assignments in the justfile",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s*\\n[a-z_]+_version := \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update git commit pins in the justfile",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>[^\\s]+) currentValue=(?<currentValue>[^\\s]+)\\s*\\n[a-z_]+_rev := \"(?<currentDigest>[a-f0-9]{40})\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Update OpenTelemetry stable and experimental log modules together",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["go.opentelemetry.io/otel{,/**}"],
      "groupName": "OpenTelemetry",
      "automerge": false
    }
  ]
}
